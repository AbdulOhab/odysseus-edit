# Copy to .env and fill in only the keys for providers you enable in
# config/providers.toml. .env is ignored by git.

# Z.ai GLM (Anthropic-compatible endpoint). Use a pay-as-you-go API key:
# Z.ai's GLM Coding Plan is limited to Z.ai's supported coding tools.
ZAI_API_KEY=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Server
ODYSSEUS_EDIT_HOST=127.0.0.1
ODYSSEUS_EDIT_PORT=7020
# Path to the provider config (default: config/providers.toml, falling back
# to config/providers.example.toml when the former is missing)
# ODYSSEUS_EDIT_PROVIDERS=config/providers.toml
